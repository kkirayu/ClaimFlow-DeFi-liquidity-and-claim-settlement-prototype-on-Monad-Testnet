# ---------------------------------------------------------------------------
# Deployment / scripts (server-side only — never expose PRIVATE_KEY to Vite)
# ---------------------------------------------------------------------------
# Required only for Monad Testnet deployment and CLI benchmarks. Use a dedicated,
# funded testnet key. Never commit this file or a real key.
PRIVATE_KEY=

# Public Monad Testnet RPC. Override with your provider if needed.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Local Anvil (public development account #0 from the default mnemonic)
LOCAL_RPC_URL=http://127.0.0.1:8545
DEPLOYER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Optional role addresses. If omitted, the deployer receives the role.
CLAIM_OPERATOR_ADDRESS=
CLAIM_APPROVER_ADDRESS=
SETTLEMENT_ADDRESS=
CLAIM_CANCELLER_ADDRESS=

# Demo-only: lets one wallet submit and approve its own claim. Defaults to true
# for local deployments and false for Monad Testnet.
ALLOW_SELF_APPROVAL=

# Batch cap (1-50). Defaults to 20.
MAX_BATCH_SIZE=20

# Benchmark signer/account. Defaults to PRIVATE_KEY on testnet and the local
# Anvil account on localhost. This account needs all protocol roles for
# settlement benchmarks.
BENCHMARK_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Frontend (Vite). Copy to frontend/.env.local or let the deploy script write it.
# All values here are public; never put a private key in a VITE_ variable.
# ---------------------------------------------------------------------------
VITE_CHAIN_ID=10143
VITE_CHAIN_NAME=Monad Testnet
VITE_RPC_URL=https://testnet-rpc.monad.xyz
VITE_EXPLORER_URL=https://testnet.monadscan.com
VITE_EXPLORER_NAME=Monadscan
VITE_NATIVE_SYMBOL=MON
VITE_NETWORK_LABEL=Monad Testnet
VITE_PROVIDER_LABEL=QuickNode public RPC

VITE_MOCK_USDC_ADDRESS=
VITE_VAULT_ADDRESS=
VITE_CLAIM_MANAGER_ADDRESS=
VITE_DEPLOYMENT_BLOCK=0

# Optional WalletConnect v2 project id (enables the WalletConnect connector)
VITE_WALLETCONNECT_PROJECT_ID=

# Optional benchmark report loaded from /benchmark/latest.json
VITE_BENCHMARK_PROVIDER_LABEL=
